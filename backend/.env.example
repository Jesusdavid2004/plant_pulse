# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/plantpulse"

# CORS: the exact origin of the frontend
CORS_ORIGIN="http://localhost:5173"

# Number of reverse proxies in front of the API (nginx, Railway edge). Used for client IPs in rate limits
TRUST_PROXY_HOPS=1

# Auth: use a random string of at least 32 characters
JWT_SECRET="change-me-to-a-long-random-string-of-32-chars-or-more"
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Use COOKIE_SAME_SITE=none (requires HTTPS) when the frontend and API live on different domains
COOKIE_SAME_SITE=lax

# Uploads
MAX_FILE_SIZE=5242880
UPLOAD_DIR="./uploads"

# AI providers: gemini | groq | fake (fake needs no API key and is deterministic)
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
AI_MAX_OUTPUT_TOKENS=1200
AI_TIMEOUT_MS=30000
AI_DAILY_QUOTA_PER_USER=20

# Public URL of the web app (used for links inside emails)
APP_URL="http://localhost:5173"

# Neglect reminder emails. MAIL_TRANSPORT: smtp | file (writes HTML previews to MAIL_PREVIEW_DIR) | none
MAIL_TRANSPORT=file
MAIL_FROM="PlantPulse <no-reply@plantpulse.local>"
MAIL_PREVIEW_DIR="./tmp/mail"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
REMINDERS_ENABLED=true
REMINDER_CHECK_INTERVAL_MINUTES=60

# Rate limits
RATE_LIMIT_AUTH_PER_15_MIN=20
RATE_LIMIT_AI_PER_MIN=10
RATE_LIMIT_GENERAL_PER_MIN=300
