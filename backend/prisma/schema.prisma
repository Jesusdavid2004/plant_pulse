// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  name          String?
  plants        Plant[]
  refreshTokens RefreshToken[]
  aiUsage       AiUsageLog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Plant {
  id           String      @id @default(uuid())
  name         String
  species      String?
  commonName   String?
  careCategory String?
  petTraits    Json?
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  images       Image[]
  analyses     Analysis[]
  careEvents   CareEvent[]
  status       String      @default("active")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Image {
  id        String   @id @default(uuid())
  plantId   String
  plant     Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  url       String
  dayLabel  String
  metadata  Json?
  createdAt DateTime @default(now())
}

model Analysis {
  id          String   @id @default(uuid())
  plantId     String
  plant       Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  healthScore Int
  status      String
  diagnosis   String
  prognosis   String?
  carePlan    Json
  createdAt   DateTime @default(now())
}

enum CareType {
  WATER
  SUN
  FERTILIZE
}

model CareEvent {
  id         String   @id @default(uuid())
  plantId    String
  plant      Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  type       CareType
  occurredAt DateTime

  @@index([plantId, type, occurredAt])
}

model AiUsageLog {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      String
  model         String
  promptVersion String
  inputTokens   Int
  outputTokens  Int
  latencyMs     Int
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}

model AiCache {
  key       String   @id
  payload   Json
  createdAt DateTime @default(now())
}
