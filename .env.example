# Used by docker-compose.yml. Copy to .env and adjust. Never commit the real .env.

# Host ports (change them if they clash with other projects)
FRONTEND_PORT=5173
BACKEND_PORT=3300
DB_PORT=5433

POSTGRES_PASSWORD=plantpulse
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more

# AI: "fake" works without keys and returns a deterministic plant. Use "gemini" with a real key.
AI_PROVIDER=fake
AI_FALLBACK_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=
